# Copy this file to .env and fill in real values.
# Full explanation of every variable: README-ENV-SETUP.md

# ── Database (MySQL) ─────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=thero
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10

# ── App server / CORS ────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
# Exact browser origins allowed to call the API with cookies (no "*").
CORS_ALLOW_ORIGINS=
SEED_DEMO_DATA=false

# ── Auth ─────────────────────────────────────────────────────────────────
SECRET_KEY=
AUTH_COOKIE_NAME=thero_session
# true only when the site is served over HTTPS (otherwise the browser drops the cookie)
AUTH_COOKIE_SECURE=false
AUTH_SESSION_HOURS=12
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
APP_NAME=Thero
# Address users open in the browser — used to build the password-reset link
APP_BASE_URL=http://localhost:8000
RESET_TOKEN_EXPIRE_MINUTES=30
RESET_REQUEST_COOLDOWN_SECONDS=60

# ── Auth: first admin (created on startup only if no admin exists yet) ────
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── SMTP (forgot-password + registration OTP mail) ───────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
SMTP_TIMEOUT_SECONDS=10

# ── MedNova export API ────────────────────────────────────────────────────
# MedNova sends this key in the header below when calling /api/sessions/{id}/export.
# Empty = endpoint disabled.
EXPORT_API_KEY=
EXPORT_API_KEY_HEADER=X-MedNova-Key
