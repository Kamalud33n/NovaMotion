# Copy this file to .env and fill in real values. NEVER commit .env.
# For a deployed site: AUTH_COOKIE_SECURE=true, APP_BASE_URL=https://your-domain,
# CORS_ALLOW_ORIGINS=https://your-domain  (HTTPS is required for the browser camera).

# ── Database (MySQL) ─────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=novamotion
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=3600
DB_CONNECT_TIMEOUT_SECONDS=10

# ── App server / CORS ────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
# Exact browser origins allowed to call the API with cookies (no "*").
CORS_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SEED_DEMO_DATA=false

# ── Auth ─────────────────────────────────────────────────────────────────
SECRET_KEY=generate_a_long_random_string_here
AUTH_COOKIE_NAME=thero_session
# true only when the site is served over HTTPS (otherwise the browser drops the cookie)
AUTH_COOKIE_SECURE=false
AUTH_SESSION_HOURS=8
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
APP_NAME=NovaMotion
# Address users open in the browser — used to build the password-reset link
APP_BASE_URL=http://localhost:8000
RESET_TOKEN_EXPIRE_MINUTES=30
RESET_REQUEST_COOLDOWN_SECONDS=60

# ── Auth: first admin (created on startup only if no admin exists yet) ────
ADMIN_NAME=NovaMotion Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_strong_password

# ── SMTP (forgot-password mail) ──────────────────────────────────────────
# TLS = STARTTLS (port 587). Gmail needs an app password, no spaces.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_user@example.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=NovaMotion
SMTP_TIMEOUT_SECONDS=15

# ── MedNova export API ───────────────────────────────────────────────────
# MedNova sends this key in the header below when calling /api/sessions/{id}/export.
# Empty = export API disabled (503).
EXPORT_API_KEY=generate_a_long_random_string_here
EXPORT_API_KEY_HEADER=X-Export-Key
